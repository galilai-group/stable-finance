{
  "name": "e1b_mean_variance",
  "description": "The cost-aware mean-variance allocator on the E1 oracles at three ICs: the one construction whose book depends on the cost it is billed.",
  "eval_month": "2020-08",
  "history_month": "2020-07",
  "horizons": [300, 900, 3600],
  "forecasts": {"kind": "oracle", "ic": [0.01, 0.03, 0.1],
                "noise": ["tails", "middle", "random"], "seed": 0},
  "configs": {
    "base": {"cost_model": "cross", "risk_model": "shrunk_sample", "universe": "all",
             "annualization": "decisions", "weighting": "mean_variance"},
    "grid": {"selection": ["all", "decile"], "efq": [0.0, 0.7], "rebalance": ["every_decision", "horizon"]}
  }
}
